{
  "name": "@nomadaai/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/ui": "~57.0.4",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
    "@nomadaai/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.4",
    "expo-auth-session": "~57.0.2",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.3",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-localization": "~57.0.0",
    "expo-location": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.7",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.0",
    "maplibre-gl": "^4.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@nomadaai/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^react-native$": "<rootDir>/src/__tests__/__stubs__/native.js",
      "^expo-location$": "<rootDir>/src/__tests__/__stubs__/native.js",
      "^expo-task-manager$": "<rootDir>/src/__tests__/__stubs__/native.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/src/__tests__/__stubs__/native.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__stubs__"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@nomadaai/shared))"
    ]
  }
}
